rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────────────────────────────

    function isValidUSN(usn) {
      return usn is string
        && usn.size() == 10
        && usn.matches('^4BD[0-9]{2}[A-Z]{2}[0-9]{3}$');
    }

    function isValidName(name) {
      return name is string
        && name.size() >= 2;
    }

    // ── results ──────────────────────────────────────────────────────────────
    match /results/{id} {
      // Public read, create, update access for student calculations & updates
      allow read, create, update: if true;

      // Admin can delete any record
      allow delete: if request.auth != null;
    }

    // ── identities ────────────────────────────────────────────────────────────
    match /identities/{usn} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }

    // ── admins ────────────────────────────────────────────────────────────────
    match /admins/{id=**} {
      allow read, write: if request.auth != null;
    }

    // ── audit_logs ────────────────────────────────────────────────────────────
    match /audit_logs/{id=**} {
      allow read, write: if true;
    }

    // ── settings ─────────────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── analytics/global ─────────────────────────────────────────────────────
    match /analytics/{docId} {
      allow read, write: if true;
    }

    // ── visits ────────────────────────────────────────────────────────────────
    match /visits/{sessionId} {
      allow create: if
        request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() > 0;
      allow read, update, delete: if request.auth != null;
    }

    // ── curriculum ────────────────────────────────────────────────────────────
    match /curriculum/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
