rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── results ──────────────────────────────────────────────────────────
    match /results/{id} {
      // Allow public create with basic field validation (including branch/semester)
      allow create: if
        request.resource.data.keys().hasAll(['name', 'usn', 'sgpa', 'subjects', 'timestamp', 'branch', 'semester'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.usn is string
        && request.resource.data.usn.matches('^4BD[0-9]{2}[A-Z]{2}[0-9]{3}$')
        && request.resource.data.sgpa is number
        && request.resource.data.sgpa >= 0
        && request.resource.data.sgpa <= 10
        && request.resource.data.branch is string
        && request.resource.data.semester is number;

      // Admin can read, update, delete
      allow read, update, delete: if request.auth != null;
    }

    // ── analytics/global ─────────────────────────────────────────────────
    // Open read/write — only stores aggregate counters (no PII)
    match /analytics/{docId} {
      allow read, write: if true;
    }

    // ── visits ────────────────────────────────────────────────────────────
    match /visits/{sessionId} {
      // Allow create once per session (sessionId is the doc ID)
      allow create: if request.resource.data.sessionId is string;
      allow read, update, delete: if request.auth != null;
    }

    // ── curriculum ────────────────────────────────────────────────────────
    match /curriculum/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
